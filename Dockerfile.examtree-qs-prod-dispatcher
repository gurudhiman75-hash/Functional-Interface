# Production-only Cloud Tasks dispatcher, for FUTURE gated production rollout.
# Build-only: never deploy to the staging job, API service or background workers.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN node artifacts/api-server/build-qs-prod-dispatcher.mjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production EXAMTREE_API_RUNTIME=cloud-run EXAMTREE_API_STAGING=false
WORKDIR /app
COPY --from=builder /src/artifacts/api-server/dist/qs-prod-dispatch-once.mjs /app/artifacts/api-server/dist/qs-prod-dispatch-once.mjs
COPY --from=builder /src/node_modules /app/node_modules
COPY --from=builder /src/artifacts/api-server/node_modules /app/artifacts/api-server/node_modules
COPY --from=builder /src/lib /app/lib
USER node
CMD ["node","artifacts/api-server/dist/qs-prod-dispatch-once.mjs"]

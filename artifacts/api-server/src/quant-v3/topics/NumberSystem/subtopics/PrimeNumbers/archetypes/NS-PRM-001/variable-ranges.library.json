    },
    "primeDefinition": "A natural number greater than 1 having exactly two factors: 1 and itself.",
    "compositeDefinition": "A natural number greater than 1 having more than two factors.",
    "numberOnePolicy": {
      "classification": "1 is neither Prime nor Composite.",
      "invalidGeneratedValueFor": ["CP-001", "CP-006", "CP-007"],
      "validationRule": "Future runtime validation must reject 1 for CP-001, CP-006, and CP-007."
    },
    "previousPrimePolicy": {
      "minimumNumber": 3,
      "rule": "number >= 3",
      "reason": "A previous prime must exist."
    },
    "rangePrimeExistencePolicy": {
      "CP-003": "Generated ranges must contain at least one prime.",
      "CP-004": "Generated ranges must contain at least one prime.",
      "CP-002": "Zero-prime ranges may produce answer 0 and must be auditable.",
      "CP-005": "Zero-prime ranges may produce answer 0 and must be auditable."

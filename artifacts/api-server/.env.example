# Existing ExamTree student/public schema database.
DATABASE_URL=postgresql://student-role:password@student-host/neondb?sslmode=require

# New ExamTree namespaced admin schema database.
# Required for /api/admin/question-studio/* in production.
ADMIN_DATABASE_URL=postgresql://admin-role:password@admin-host/neondb?sslmode=require

# Firebase Admin service account settings used to verify ID tokens.
FIREBASE_PROJECT_ID=sarbedutech
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PORT=3001
NODE_ENV=development

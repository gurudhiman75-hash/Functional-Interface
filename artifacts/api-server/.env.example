# Single canonical ExamTree Neon database containing identity, catalog, content,
# assessment, learning, operations and platform schemas.
DATABASE_URL=postgresql://role:password@canonical-host/neondb?sslmode=require

# Temporary rollout compatibility only. When present, the API prefers this
# value so existing Render deployments can cut over before removing the old
# DATABASE_URL secret. Delete it after DATABASE_URL points to the same project.
# ADMIN_DATABASE_URL=postgresql://role:password@canonical-host/neondb?sslmode=require

# Firebase Admin service account settings used to verify ID tokens.
FIREBASE_PROJECT_ID=sarbedutech
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PORT=3001
NODE_ENV=development

# Staging ONLY: one-shot Question Studio outbox -> Cloud Tasks publisher.
# Never deploy this image over the existing API or background jobs.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN node artifacts/api-server/build-qs-staging-dispatcher.mjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production EXAMTREE_API_RUNTIME=cloud-run EXAMTREE_API_STAGING=true
WORKDIR /app
COPY --from=builder /src/artifacts/api-server/dist/qs-staging-dispatch-once.mjs /app/artifacts/api-server/dist/qs-staging-dispatch-once.mjs
COPY --from=builder /src/node_modules /app/node_modules
COPY --from=builder /src/artifacts/api-server/node_modules /app/artifacts/api-server/node_modules
COPY --from=builder /src/lib /app/lib
USER node
CMD ["node","artifacts/api-server/dist/qs-staging-dispatch-once.mjs"]

# Production-only Question Studio compute image, build-only and disabled by default.
# No DATABASE_URL, Firebase credentials, payment keys or admin session cookies.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN node artifacts/api-server/build-universal-worker.mjs

# Copy only runtime static data needed by source-file-backed CP authorities.
RUN set -eu; \
  mkdir -p /src/runtime-assets; \
  cd /src; \
  for dir in artifacts/api-server/src/quant-v4 artifacts/api-server/src/reasoning-v1 artifacts/api-server/src/language-v1 artifacts/api-server/src/knowledge-v1; do \
    if [ -d "$dir" ]; then \
      find "$dir" -type f \( -name '*.json' -o -name '*.md' \) \
        ! -name '*.env*' ! -name '*service-account*' ! -name '*private-key*' \
        -exec cp --parents '{}' /src/runtime-assets/ \; ; \
    fi; \
  done

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=8080 EXAMTREE_API_RUNTIME=cloud-run EXAMTREE_API_STAGING=false
WORKDIR /app
COPY --from=builder /src/artifacts/api-server/dist/question-studio-universal-worker.mjs /app/artifacts/api-server/dist/question-studio-universal-worker.mjs
COPY --from=builder /src/artifacts/api-server/dist/universal-question-studio-worker-service.mjs /app/artifacts/api-server/dist/universal-question-studio-worker-service.mjs
COPY --from=builder /src/artifacts/api-server/prod-universal-worker-service.mjs /app/artifacts/api-server/dist/prod-universal-worker-service.mjs
COPY --from=builder /src/artifacts/api-server/production-canary-worker-scope.mjs /app/artifacts/api-server/dist/production-canary-worker-scope.mjs
COPY --from=builder /src/artifacts/api-server/dist/prod-worker-review-scope.mjs /app/artifacts/api-server/dist/prod-worker-review-scope.mjs
COPY --from=builder /src/node_modules /app/node_modules
COPY --from=builder /src/artifacts/api-server/node_modules /app/artifacts/api-server/node_modules
COPY --from=builder /src/lib /app/lib
COPY --from=builder /src/runtime-assets/artifacts/api-server/src/ /app/artifacts/api-server/src/
USER node
EXPOSE 8080
CMD ["node", "artifacts/api-server/dist/prod-universal-worker-service.mjs"]

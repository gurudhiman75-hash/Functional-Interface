# Standalone Express API image for Cloud Run. Cloudflare serves the SPAs.
# Build is intentionally independent of Render's UI builds and DB migrations.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN node artifacts/api-server/build-runtime.mjs
RUN node artifacts/api-server/build-cloud-run-background.mjs

# Bundle only runtime JSON/metadata; no exported review images, private keys,
# dev audit files or source TypeScript. Source-file readers remain supported.
RUN set -eu; \
    mkdir -p /src/runtime-assets; \
    cd /src; \
    find artifacts/api-server/src/quant-v4 artifacts/api-server/src/reasoning-v1 \
      -type f \( -name '*.json' -o -name '*.md' \) \
      ! -name '*.env*' ! -name '*service-account*' ! -name '*private-key*' \
      -exec cp --parents '{}' /src/runtime-assets/ \;

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    EXAMTREE_API_RUNTIME=cloud-run \
    PORT=8080
WORKDIR /app
COPY --from=builder /src/artifacts/api-server/dist /app/artifacts/api-server/dist
COPY --from=builder /src/node_modules /app/node_modules
COPY --from=builder /src/artifacts/api-server/node_modules /app/artifacts/api-server/node_modules
COPY --from=builder /src/lib /app/lib
COPY --from=builder /src/runtime-assets/artifacts/api-server/src/ /app/artifacts/api-server/src/
USER node
EXPOSE 8080
CMD ["node", "artifacts/api-server/dist/index.mjs"]

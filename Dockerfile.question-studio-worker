# Cloud Run compute-only image. The heavy generation graph is NEVER imported
# by the student API; this container is allocated 2 GiB only while invoked.
FROM node:22-bookworm-slim AS builder
WORKDIR /src
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN node artifacts/api-server/build-trg002-worker.mjs

FROM node:22-bookworm-slim
ENV NODE_ENV=production
ENV PORT=8080
WORKDIR /app
COPY --from=builder /src/artifacts/api-server/trg002-worker-service.mjs /app/artifacts/api-server/dist/trg002-worker-service.mjs
COPY --from=builder /src/artifacts/api-server/dist/question-studio-trg002-worker.mjs /app/artifacts/api-server/dist/question-studio-trg002-worker.mjs
# Preserve Node dependency resolution for esbuild-externalized optional modules.
COPY --from=builder /src/node_modules /app/node_modules
COPY --from=builder /src/artifacts/api-server/node_modules /app/artifacts/api-server/node_modules
COPY --from=builder /src/lib /app/lib
USER node
EXPOSE 8080
CMD ["node", "artifacts/api-server/dist/trg002-worker-service.mjs"]

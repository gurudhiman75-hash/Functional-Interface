rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Examtree media is uploaded only by the authenticated admin API through
    // Firebase Admin SDK. Client SDKs never receive direct write authority.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
